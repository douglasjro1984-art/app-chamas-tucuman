# Copia este archivo como backend/.env y completalo con tus credenciales.
# NUNCA subas backend/.env al repositorio (está en .gitignore).

# Conexión a la base de datos (TiDB Cloud / MySQL)
DB_HOST=tu-host.tidbcloud.com
DB_USER=tu-usuario.root
DB_PASSWORD=tu-contrasena
DB_NAME=tu-base-de-datos
DB_PORT=4000
DB_SSL=true

# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=genera-una-cadena-aleatoria-larga

# Entorno: development | production
NODE_ENV=production
